// LATIHAN 10.1

function countFrequency(array) {
  return array.reduce((counts, item) => {
    // Jika item belum ada
    if (counts[item] === undefined) {
      counts[item] = 1;
    }

    // Jika item sudah ada
    else {
      counts[item] = counts[item] + 1;
    }

    return counts;
  }, {});
}

