// FREQUENCY CATEGORY

function getCategoryFrequency(products) {
  const categories = products.map((product) => product.category);

  return countFrequency(categories);
}

console.log("\n===== FREQUENCY CATEGORY =====");

console.log(getCategoryFrequency(products));

// FREQUENCY RATING

function getRatingFrequency(products) {
  const ratings = products.map((product) => product.rating);

  return countFrequency(ratings);
}

console.log("\n===== FREQUENCY RATING =====");

console.log(getRatingFrequency(products));
