const searchHistory = new Stack();

// Riwayat pencarian
searchHistory.push("laptop");
searchHistory.push("gaming laptop");
searchHistory.push("asus");
searchHistory.push("asus tuf");

function undoSearch() {
  if (searchHistory.isEmpty()) {
    return null;
  }

  return searchHistory.pop();
}

