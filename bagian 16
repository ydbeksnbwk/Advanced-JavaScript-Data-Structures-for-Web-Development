// Membuat array 10.000 angka
const numbers = Array.from({ length: 10000 }, (_, i) => i + 1);

// LINEAR SEARCH — O(n)

function linearSearch(array, target) {
  let steps = 0;

  for (let i = 0; i < array.length; i++) {
    steps++;

    if (array[i] === target) {
      return {
        index: i,
        steps: steps,
      };
    }
  }

  return {
    index: -1,
    steps: steps,
  };
}

// BINARY SEARCH — O(log n)

function binarySearch(array, target) {
  let left = 0;
  let right = array.length - 1;

  let steps = 0;

  while (left <= right) {
    steps++;

    const mid = Math.floor((left + right) / 2);

    if (array[mid] === target) {
      return {
        index: mid,
        steps: steps,
      };
    }

    if (array[mid] < target) {
      left = mid + 1;
    } else {
      right = mid - 1;
    }
  }

  return {
    index: -1,
    steps: steps,
  };
}

// Target dibuat di posisi paling akhir
const target = 10000;

// Jalankan Linear Search
const linearStart = performance.now();

const linearResult = linearSearch(numbers, target);

const linearEnd = performance.now();

// Jalankan Binary Search
const binaryStart = performance.now();

const binaryResult = binarySearch(numbers, target);

const binaryEnd = performance.now();

// Output
console.log("================================");
console.log("LATIHAN 16.1");
console.log("================================");

console.log("\nLinear Search");
console.log("Index:", linearResult.index);
console.log("Steps:", linearResult.steps);
console.log("Time:", (linearEnd - linearStart).toFixed(6), "ms");

console.log("\nBinary Search");
console.log("Index:", binaryResult.index);
console.log("Steps:", binaryResult.steps);
console.log("Time:", (binaryEnd - binaryStart).toFixed(6), "ms");

// LATIHAN 16.2

// Membuat 1000 products
const products = Array.from({ length: 1000 }, (_, i) => ({
  id: i + 1,
  title: `Product ${i + 1}`,
  category: `category-${i % 10}`,
}));

// METODE 1

function findSameCategoryPairsNested(products) {
  const pairs = [];

  let comparisons = 0;

  for (let i = 0; i < products.length; i++) {
    for (let j = i + 1; j < products.length; j++) {
      comparisons++;

      if (products[i].category === products[j].category) {
        pairs.push([products[i], products[j]]);
      }
    }
  }

  return {
    pairs,
    comparisons,
  };
}

// METODE 2

function groupProductsByCategory(products) {
  const groups = new Map();

  let operations = 0;

  for (const product of products) {
    operations++;

    if (!groups.has(product.category)) {
      groups.set(product.category, []);
    }

    groups.get(product.category).push(product);
  }

  return {
    groups,
    operations,
  };
}

// Jalankan nested loop
const nestedStart = performance.now();

const nestedResult = findSameCategoryPairsNested(products);

const nestedEnd = performance.now();

// Jalankan grouping
const groupingStart = performance.now();

const groupingResult = groupProductsByCategory(products);

const groupingEnd = performance.now();

// Output
console.log("\n================================");
console.log("LATIHAN 16.2");
console.log("================================");

console.log("\nNested Loop O(n²)");

console.log("Jumlah perbandingan:", nestedResult.comparisons);

console.log("Jumlah pasangan:", nestedResult.pairs.length);

console.log("Time:", (nestedEnd - nestedStart).toFixed(6), "ms");

console.log("\nGrouping dengan Map O(n)");

console.log("Jumlah operasi:", groupingResult.operations);

console.log("Jumlah kategori:", groupingResult.groups.size);

console.log("Time:", (groupingEnd - groupingStart).toFixed(6), "ms");
