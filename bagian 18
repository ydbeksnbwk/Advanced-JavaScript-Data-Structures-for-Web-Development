// ==========================================
// BAGIAN 18 — SIMPLE STATE MANAGEMENT
// ==========================================

// ==========================================
// DATA PRODUCTS
// ==========================================

const products = [
  {
    id: 1,
    title: "Laptop",
    price: 1200,
    rating: 4.5,
    category: "laptops",
  },

  {
    id: 2,
    title: "Gaming Laptop",
    price: 1500,
    rating: 4.7,
    category: "laptops",
  },

  {
    id: 3,
    title: "Smartphone",
    price: 800,
    rating: 4.2,
    category: "phones",
  },

  {
    id: 4,
    title: "iPhone",
    price: 1000,
    rating: 4.6,
    category: "phones",
  },

  {
    id: 5,
    title: "Headphones",
    price: 100,
    rating: 4.8,
    category: "audio",
  },
];

// ==========================================
// STATE
// ==========================================

const state = {
  // Semua products
  products: products,

  // Keyword pencarian
  search: "",

  // Category yang dipilih
  category: "all",

  // Sorting yang dipilih
  sortBy: "default",

  // Favorite products
  favorites: [],

  // Status aplikasi
  status: "success",
};

// ==========================================
// RENDER PRODUCT
// ==========================================

function renderProducts(products) {
  const container = document.querySelector("#product-list");

  container.innerHTML = "";

  // Jika tidak ada product
  if (products.length === 0) {
    container.innerHTML = `
            <p class="empty">
                Produk tidak ditemukan.
            </p>
        `;

    return;
  }

  // Buat card setiap product
  for (const product of products) {
    const card = document.createElement("div");

    card.classList.add("product-card");

    card.innerHTML = `
            <h3>
                ${product.title}
            </h3>

            <p>
                Kategori: ${product.category}
            </p>

            <p>
                Harga: $${product.price}
            </p>

            <p>
                Rating: ⭐ ${product.rating}
            </p>
        `;

    container.append(card);
  }
}

// ==========================================
// RENDER UTAMA
// ==========================================

function render() {
  // Mulai dari semua products
  let result = state.products;

  // --------------------------------------
  // FILTER SEARCH
  // --------------------------------------

  if (state.search !== "") {
    result = result.filter((product) =>
      product.title.toLowerCase().includes(state.search.toLowerCase()),
    );
  }

  // --------------------------------------
  // FILTER CATEGORY
  // --------------------------------------

  if (state.category !== "all") {
    result = result.filter((product) => product.category === state.category);
  }

  // --------------------------------------
  // SORTING
  // --------------------------------------

  if (state.sortBy === "price-asc") {
    result = [...result].sort((a, b) => a.price - b.price);
  }

  if (state.sortBy === "price-desc") {
    result = [...result].sort((a, b) => b.price - a.price);
  }

  if (state.sortBy === "rating") {
    result = [...result].sort((a, b) => b.rating - a.rating);
  }

  if (state.sortBy === "title") {
    result = [...result].sort((a, b) => a.title.localeCompare(b.title));
  }

  // --------------------------------------
  // RENDER KE DOM
  // --------------------------------------

  renderProducts(result);
}

// ==========================================
// SEARCH EVENT
// ==========================================

const searchInput = document.querySelector("#search-input");

searchInput.addEventListener("input", function (event) {
  // Update state
  state.search = event.target.value;

  // Render ulang
  render();
});

// ==========================================
// CATEGORY EVENT
// ==========================================

const categorySelect = document.querySelector("#category-select");

categorySelect.addEventListener("change", function (event) {
  // Update state
  state.category = event.target.value;

  // Render ulang
  render();
});

// ==========================================
// SORT EVENT
// ==========================================

const sortSelect = document.querySelector("#sort-select");

sortSelect.addEventListener("change", function (event) {
  // Update state
  state.sortBy = event.target.value;

  // Render ulang
  render();
});

// ==========================================
// INITIAL RENDER
// ==========================================

render();
