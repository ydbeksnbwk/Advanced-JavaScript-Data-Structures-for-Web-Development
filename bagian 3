// LATIHAN 3.3

function getReviewSummary(products) {
  return products.map((product) => {
    return {
      id: product.id,
      title: product.title,
      totalReviews: product.reviews.length,
    };
  });
}

console.log("\n===== LATIHAN 3.3 =====");
console.log(getReviewSummary(products));

// LATIHAN 3.4

function getHighRatingReviews(products, minimumRating = 5) {
  return products.map((product) => {
    return {
      id: product.id,
      title: product.title,
      reviews: product.reviews.filter(
        (review) => review.rating >= minimumRating,
      ),
    };
  });
}

console.log("\n===== LATIHAN 3.4 =====");
console.log(getHighRatingReviews(products, 5));

// LATIHAN 3.5

function getAverageRatings(products) {
  return products.map((product) => {
    // Kalau tidak ada review
    if (product.reviews.length === 0) {
      return {
        id: product.id,
        title: product.title,
        averageRating: 0,
      };
    }

    const totalRating = product.reviews.reduce(
      (sum, review) => sum + review.rating,
      0,
    );

    const averageRating = totalRating / product.reviews.length;

    return {
      id: product.id,
      title: product.title,
      averageRating: averageRating,
    };
  });
}

console.log("\n===== LATIHAN 3.5 =====");
console.log(getAverageRatings(products));

// LATIHAN 3.6

function getMostReviewedProduct(products) {
  if (products.length === 0) {
    return undefined;
  }

  return products.reduce((mostReviewed, product) => {
    if (product.reviews.length > mostReviewed.reviews.length) {
      return product;
    }

    return mostReviewed;
  });
}

console.log("\n===== LATIHAN 3.6 =====");
console.log(getMostReviewedProduct(products));

