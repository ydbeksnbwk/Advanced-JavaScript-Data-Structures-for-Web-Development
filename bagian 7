// LATIHAN 7.1

function binarySearch(array, target) {
  let left = 0;
  let right = array.length - 1;

  while (left <= right) {
    const mid = Math.floor((left + right) / 2);

    // Jika nilai tengah sama dengan target
    if (array[mid] === target) {
      return mid;
    }

    // Jika nilai tengah lebih kecil,
    // cari ke sebelah kanan
    if (array[mid] < target) {
      left = mid + 1;
    }

    // Jika nilai tengah lebih besar,
    // cari ke sebelah kiri
    else {
      right = mid - 1;
    }
  }

  // Tidak ditemukan
  return -1;
}

// TEST

const numbers = [10, 20, 30, 40, 50, 60, 70];

console.log("Cari 60:");
console.log(binarySearch(numbers, 60));

console.log("Cari 30:");
console.log(binarySearch(numbers, 30));

console.log("Cari 55:");
console.log(binarySearch(numbers, 55));

// LATIHAN 7.2

const products = [
  {
    id: 1,
    title: "Laptop",
    price: 1200,
  },

  {
    id: 2,
    title: "Smartphone",
    price: 800,
  },

  {
    id: 3,
    title: "Headphones",
    price: 100,
  },
];

// STEP 1

const sortedProducts = [...products].sort((a, b) => a.price - b.price);

console.log("===== SORTED PRODUCTS =====");
console.log(sortedProducts);

// STEP 2

function binarySearchByPrice(products, targetPrice) {
  let left = 0;
  let right = products.length - 1;

  while (left <= right) {
    const mid = Math.floor((left + right) / 2);

    // Jika harga sama dengan target
    if (products[mid].price === targetPrice) {
      return products[mid];
    }

    // Jika harga tengah lebih kecil,
    // cari ke kanan
    if (products[mid].price < targetPrice) {
      left = mid + 1;
    }

    // Jika harga tengah lebih besar,
    // cari ke kiri
    else {
      right = mid - 1;
    }
  }

  return undefined;
}

// TEST

console.log("\n===== BINARY SEARCH =====");

console.log("Cari harga 800:", binarySearchByPrice(sortedProducts, 800));

console.log("Cari harga 500:", binarySearchByPrice(sortedProducts, 500));
