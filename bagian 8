// LATIHAN 8.1

function bubbleSort(numbers) {
  // Salin array agar tidak memutasi
  // array asli
  const arr = [...numbers];

  for (let i = 0; i < arr.length - 1; i++) {
    for (let j = 0; j < arr.length - 1 - i; j++) {
      // Jika angka kiri lebih besar
      // dari angka kanan
      if (arr[j] > arr[j + 1]) {
        // Tukar posisi
        [arr[j], arr[j + 1]] = [arr[j + 1], arr[j]];
      }
    }
  }

  return arr;
}

