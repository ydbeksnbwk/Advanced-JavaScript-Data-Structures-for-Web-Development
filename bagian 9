console.log(groupedProducts);

// LATIHAN 9.2

function getCategorySummary(groupedProducts) {
  return Object.keys(groupedProducts).map((category) => {
    return {
      category: category,
      totalProducts: groupedProducts[category].length,
    };
  });
}

const summary = getCategorySummary(groupedProducts);

console.log("\n===== LATIHAN 9.2 =====");

